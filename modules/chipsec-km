# chipsec-km: out-of-tree CHIPSEC Linux kernel module (chipsec.ko).
#
# STATUS: DRAFT / OPT-IN. Separate from userspace `modules/chipsec`.
#
# Purpose:
# - Build chipsec.ko against the exact Heads-built kernel tree and stage it
#   into modules.cpio for driver-backed CHIPSEC Linux helper functionality.
#
# Not automatic:
# - Not enabled by default. No auto-insmod at boot. Loading a kernel module has
#   security/runtime impact; load manually only when needed:
#     insmod /lib/modules/chipsec.ko
# - Upstream chipsec insmod.sh performs PCR measurement behavior; do not copy it
#   blindly into Heads boot flow without security review.
#
# Prereqs / limits:
# - Requires CONFIG_CHIPSEC=y and CONFIG_LINUX=y.
# - Requires kernel module support (CONFIG_MODULES=y). modversions/unload not
#   required for insmod path; busybox insmod/lsmod sufficient.
# - Built against $(build)/$(linux_dir); vermagic/config must match running
#   Heads kernel.
# - QEMU can validate build/staging/load wiring only; most CHIPSEC driver-backed
#   checks are hardware-specific. Automated QA remains TODO.
CONFIG_CHIPSEC_KM ?= n

ifeq "$(CONFIG_CHIPSEC_KM)" "y"
ifneq "$(CONFIG_CHIPSEC)" "y"
$(error CONFIG_CHIPSEC_KM=y requires CONFIG_CHIPSEC=y)
endif
ifeq "$(CONFIG_LINUX_VERSION)" ""
$(error CONFIG_CHIPSEC_KM=y requires CONFIG_LINUX_VERSION to be set)
endif
endif

# Not a normal define_module module: it reuses chipsec source dir/canary.
# Hooked via explicit rules below when enabled.
chipsec-km_dir = $(chipsec_dir)
# Compute linux build dir independently (modules/linux loads alphabetically later).
chipsec-km_linux_kconfig = $(or $(CONFIG_LINUX_CONFIG),config/linux.config)
chipsec-km_linux_dir = linux-$(CONFIG_LINUX_VERSION)/$(notdir $(basename $(chipsec-km_linux_kconfig)))
chipsec-km_linux_arch = $(LINUX_ARCH)
chipsec-km_depends := linux chipsec

ifeq "$(CONFIG_CHIPSEC_KM)" "y"
ifneq "$(CONFIG_CPYTHON)" "y"
$(error CONFIG_CHIPSEC_KM=y requires CONFIG_CPYTHON=y (chipsec userspace profile))
endif

chipsec-km_ko_src := $(build)/$(chipsec-km_dir)/drivers/linux/chipsec.ko
chipsec-km_ko_staged := $(build)/$(BOARD)/chipsec-km/chipsec.ko

# Build out-of-tree chipsec.ko against the Heads kernel build tree.
# chipsec driver needs nasm for amd64 asm; use coreboot crossgcc nasm.
chipsec-km_nasm_path = $(build)/coreboot-$(CONFIG_COREBOOT_VERSION)/util/crossgcc/xgcc/bin:$(build)/coreboot-25.09/util/crossgcc/xgcc/bin

$(chipsec-km_ko_src): $(build)/$(chipsec_dir)/.canary $(build)/$(chipsec-km_linux_dir)/.build
	$(call do,MAKE,chipsec-km,\
		PATH="$(chipsec-km_nasm_path):$$PATH" \
		$(CROSS_TOOLS) \
		$(MAKE) -C "$(build)/$(linux_dir)" \
			M="$(build)/$(chipsec-km_dir)/drivers/linux" \
			ARCH="$(LINUX_ARCH)" \
			CROSS_COMPILE="$(CROSS)" \
			KSRC="$(build)/$(linux_dir)" \
			KVER="$(linux_version)" \
			SKIP_STACK_VALIDATION=1 \
			modules)

$(chipsec-km_ko_staged): $(chipsec-km_ko_src)
	$(call do,INSTALL-MODULE,chipsec.ko,\
		mkdir -p "$(dir $@)" && \
		$(CROSS)strip --preserve-dates --strip-unneeded -o "$@" "$(chipsec-km_ko_src)")

# Makefile collects these for modules.cpio staging when CONFIG_CHIPSEC_KM=y.
chipsec-km_modules := $(chipsec-km_ko_staged)|lib/modules/chipsec.ko
chipsec-km_modules_depends := $(chipsec-km_ko_staged)

endif
