# Host CPython (build-only, glibc BUILT-TOOL).  M0 spike scope.
#
# Supplies the `--with-build-python` interpreter required to cross-build the
# target CPython in modules/cpython: the pinned dev-env image's Python 3.11
# cannot build a 3.13 target (major.minor must match), so we build the same
# pinned 3.13.x source natively in-image.  This is an ordinary host build
# (container GCC, glibc); it links against the host libc, not musl.
#
# SEPARATION (deliberate): cpython-host is a build tool only and is NEVER
# shipped.  There is no bin_modules entry in the Makefile and no _data/
# _libraries here; the ./python interpreter stays inside its build directory
# and is not stripped (nothing downstream packages it) -- no initrd strip
# helper ever sees it.  Its only consumer is modules/cpython, which sets
# `cpython_depends := cpython-host ...`.
#
# The eventually-shipped modules/cpython, cryptodome, python-zstd and
# wyng-backup are a different thing entirely: those are musl target
# cross-builds using $(CROSS)/$(heads_cc), packed into tools.cpio (/bin, /lib,
# site-packages) like every other module.  Because _data-staged files
# (site-packages/*.so, stdlib) are not covered by the initrd strip helpers,
# those modules must strip their own .so explicitly in their _target before
# staging.
#
# Gated on CONFIG_CPYTHON so it is bypassed entirely on boards that do not
# ship the target interpreter.
CONFIG_CPYTHON ?= n
modules-$(CONFIG_CPYTHON) += cpython-host

cpython-host_version := 3.13.15
cpython-host_dir := Python-$(cpython-host_version)-host
cpython-host_tar := Python-$(cpython-host_version).tar.xz
cpython-host_url := https://www.python.org/ftp/python/$(cpython-host_version)/$(cpython-host_tar)
cpython-host_hash := 1e66a7945a48390ee4c2a4268a0e4185884059a13c4aab6d148aa208deea4a76

# Host build only: no CROSS_TOOLS, no target flags, no --prefix/install.
# --build pins config.guess so the triplet does not depend on the host kernel.
#
# SOURCE_DATE_EPOCH=0 follows the Heads convention for extracted tarballs
# (doc/reproducible-builds.md; modules/busybox): the tree has no .git from
# which to derive a commit epoch.  GCC uses it for deterministic __DATE__/
# __TIME__, and CPython's generated bytecode/frozen data uses it for timestamps.
# -fdebug-prefix-map normalizes the build path in debug info.
#
# --without-ensurepip: we never install from this interpreter.
# --disable-test-modules: skip the test package for a faster tool-only build.
# --without-doc-strings: smaller/faster build interpreter; irrelevant at runtime.
cpython-host_configure := \
	SOURCE_DATE_EPOCH=0 \
	CFLAGS="-fdebug-prefix-map=$(pwd)=heads -gno-record-gcc-switches" \
	./configure \
		--build=x86_64-pc-linux-gnu \
		--without-ensurepip \
		--disable-test-modules \
		--without-doc-strings

# Pass SOURCE_DATE_EPOCH through to the compile/link as well: a command-line
# make variable is exported to the recipes (gcc embeds __DATE__/__TIME__).
cpython-host_target := SOURCE_DATE_EPOCH=0 $(MAKE_JOBS)

cpython-host_output := python

cpython-host_depends :=
