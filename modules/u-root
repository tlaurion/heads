#
# u-root go runtime
#
# This is not a normal Heads module, since it builds all of its
# own dependencies.
#
u-root_url := github.com/u-root/u-root
u-root_output := $(build)/$(BOARD)/u-root.cpio
UROOT_CMDS ?=
UROOT_COMPILER ?=
UROOT_UINIT ?=

export GOPATH=$(build)/go
u-root_src_cmds := $(foreach cmd,$(UROOT_CMDS),github.com/u-root/u-root/cmds/$(cmd))

u-root_build := $(GOPATH)/bin/u-root
UROOT_COMPILER_FLAG := $(if $(UROOT_COMPILER),-compiler $(UROOT_COMPILER),)
UROOT_UINIT_FLAG := $(if $(UROOT_UINIT),-uinitcmd $(UROOT_UINIT),)
UROOT_TAGS_FLAG := $(if $(UROOT_TAGS),-tags $(UROOT_TAGS),)

UROOT_REPO ?= https://github.com/tlaurion/u-root
UROOT_COMMIT ?= main

$(GOPATH)/bin/u-root:
	mkdir -p $(GOPATH)/src/github.com/u-root
	git clone --depth=1 --branch $(UROOT_COMMIT) $(UROOT_REPO) $(GOPATH)/src/github.com/u-root/u-root
	cd $(GOPATH)/src/github.com/u-root/u-root && go build -o $(GOPATH)/bin/u-root .
#
# If the board directory has its own go commands, copy them
# into the u-root tree so that they will be bundled into the go initrd
# TODO: generalize this to support more commands
# TODO: fix this sort that it doesn't leave commands lying around
#
ifeq "y" "$(shell [ -r 'boards/$(BOARD)/uinit.go' ] && echo y)"
u-root_uinit := $(GOPATH)/src/github.com/u-root/u-root/cmds/uinit/uinit.go
$(u-root_uinit): $(u-root_build) boards/$(BOARD)/uinit.go
	$(call install,boards/$(BOARD)/uinit.go,$@)
endif

# Building with TinyGo: replace vendored golang.org/x/sys with
# TinyGo's own implementation (no .s assembly files).
$(u-root_output): $(u-root_build) $(u-root_uinit)
	$(if $(UROOT_COMPILER),\
		rm -rf $(GOPATH)/src/github.com/u-root/u-root/vendor/golang.org/x/sys && \
		cp -r $$(tinygo env TINYGOROOT)/src/golang.org/x/sys \
			$(GOPATH)/src/github.com/u-root/u-root/vendor/golang.org/x/sys)
	$(call do,U-ROOT,$@,\
		GO111MODULE=$(if $(UROOT_COMPILER),auto,off) \
		$(GOPATH)/bin/u-root \
			-build=bb \
			-format=cpio \
			-o $@  \
			$(UROOT_COMPILER_FLAG) \
			$(UROOT_TAGS_FLAG) \
			$(UROOT_UINIT_FLAG) \
			$(u-root_src_cmds)\
	)

# Override the initrd inputs and add in the kernel modules
initrd-$(CONFIG_UROOT) += $(u-root_output)


ifeq "$(CONFIG_UROOT)" "y"
# If we are building for u-root, CONFIG_HEADS can be overridden:
# - n (default): heads initrd excluded, u-root init runs directly
# - y: heads initrd included, u-root init runs heads scripts via uinitcmd
CONFIG_HEADS ?= n

# Since we do not include u-root in modules-y, we have to define our
# own intermediate and clean targets here
$(build)/$(u-root_dir)/.build: $(u-root_output)
u-root.clean:
	$(RM) $(u-root_output)
endif
