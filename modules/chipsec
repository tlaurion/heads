# chipsec: Intel CHIPSEC platform security assessment framework (userspace).
#
# STATUS: DRAFT / OPT-IN. Not wired into default boards.
#
# Purpose:
# - Model CHIPSEC Python userspace requirements in Heads CPython profile system.
# - Provide an explicit, board-testable CPython runtime contract for chipsec.
#
# Current scope (implemented):
# - Declares additive CPython profile `chipsec` (`chipsec_cpython_profiles`).
# - Declares per-board smoke imports (`chipsec_cpython_smoke_imports`).
# - Pinned upstream commit hash recorded for future packaging work.
# - Default pin currently tracks chipsec/chipsec PR2945 test commit
#   30e5aa61544ea69c25163415ecca1fba426a283d (Add common.pltrst_gpio_lock
#   module), branch dscott/pltrst_gpio_lock, base chipsec2; not merged upstream.
#   https://github.com/chipsec/chipsec/pull/2945
#   https://github.com/chipsec/chipsec/commit/30e5aa61544ea69c25163415ecca1fba426a283d
#   Revisit pin when PR2945 is merged/superseded.
#
# Not implemented yet (TODO):
# - Fetch/build/package CHIPSEC Python sources into initrd/site-packages.
# - Install chipsec entrypoints/wrappers (`chipsec_main.py`, etc.) as needed.
# - Linux helper/driver strategy: driver-backed checks require chipsec.ko;
#   build/staging is a separate opt-in module: `modules/chipsec-km`
#   (CONFIG_CHIPSEC_KM=y). It builds against $(build)/$(linux_dir) and stages
#   /lib/modules/chipsec.ko into modules.cpio. No auto-insmod.
# - QEMU automated QA: no automated QEMU boot/command-flow test in CI. Current
#   `make BOARD=<board> cpython_test` validates module-declared Python imports
#   only; it does not execute CHIPSEC commands inside a booted image.
#
# Dependency contract:
# - CONFIG_CHIPSEC=y requires CONFIG_CPYTHON=y.
# - CPython profile selection is module-driven: modules/cpython unions
#   `<mod>_cpython_profile(s)` from enabled modules-y.
# - This module owns chipsec profile/smoke declarations; modules/cpython only
#   aggregates them.
#
# Runtime/profile notes:
# - Profile adds stdlib/dynload needed by common CHIPSEC imports (csv, logging,
#   concurrent/multiprocessing, plistlib, pprint, decimal/_decimal).
# - lzma/_lzma intentionally omitted: target CPython does not build _lzma until
#   an xz/liblzma module and cpython build wiring exist. Re-add only with traced
#   need and verified build/runtime support.
#
# Kernel module (separate, implemented as draft module):
# - modules/chipsec-km builds chipsec.ko from pinned chipsec source against
#   $(build)/$(linux_dir) and stages /lib/modules/chipsec.ko into modules.cpio.
# - Requires CONFIG_CHIPSEC_KM=y, CONFIG_CHIPSEC=y, CONFIG_LINUX=y, kernel
#   CONFIG_MODULES=y, busybox insmod/lsmod. No auto-load.
# - QEMU validates wiring/build only; driver-backed checks are hardware-specific.
CONFIG_CHIPSEC ?= n

ifeq "$(CONFIG_CHIPSEC)" "y"
ifneq "$(CONFIG_CPYTHON)" "y"
$(error CONFIG_CHIPSEC=y requires CONFIG_CPYTHON=y)
endif
endif

modules-$(CONFIG_CHIPSEC) += chipsec

# CPython profile contract (consumed by modules/cpython).
chipsec_cpython_profiles += chipsec

# Pinned upstream source identity (packaging TODO; not fetched/built yet).
# Testing chipsec/chipsec PR2945 (Add common.pltrst_gpio_lock module):
# https://github.com/chipsec/chipsec/pull/2945
# PR head: 30e5aa61544ea69c25163415ecca1fba426a283d (branch dscott/pltrst_gpio_lock, base chipsec2)
# https://github.com/chipsec/chipsec/commit/30e5aa61544ea69c25163415ecca1fba426a283d
chipsec_version := git
chipsec_dir := chipsec-git
chipsec_repo := https://github.com/chipsec/chipsec.git
chipsec_commit_hash := 30e5aa61544ea69c25163415ecca1fba426a283d

chipsec_depends := cpython $(musl_dep)

# No build/package step yet. Keep target explicit/no-op until packaging lands.
chipsec_target := \
	true

# TODO(packaging): stage selected CHIPSEC package/scripts into site-packages and
# add wrappers/entrypoints as needed. Keep staged surface minimal and audited.
# chipsec_output :=
# chipsec_tools :=

# Per-board CPython smoke contract (aggregated by modules/cpython).
# Keep this list aligned with config/python/profiles/chipsec/* and actual
# CHIPSEC command/import traces before widening.
chipsec_cpython_smoke_imports := \
	decimal csv logging concurrent.futures multiprocessing plistlib pprint
