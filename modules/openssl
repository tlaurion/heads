# OpenSSL library
modules-$(CONFIG_OPENSSL) += openssl

openssl_version := 3.0.8
openssl_dir := openssl-$(openssl_version)
openssl_tar := openssl-$(openssl_version).tar.gz
openssl_url := https://www.openssl.org/source/$(openssl_tar)
openssl_hash := 6c13d2bf38fdf31eac3ce2a347073673f5d63263398f1f69d0df4a41253e4b3e

# tpm2-tss uses SHA/AES/SM3. OpenSSH and CPython's _hashlib additionally need
# DH/ECDH/ECDSA and scrypt, so those capabilities stay enabled.
# See doc/modules.md "Shared module build flags" for the section-GC/unwind rationale.

openssl_configure := \
	$(CROSS_TOOLS) \
	CFLAGS="-Os -ffunction-sections -fdata-sections -fno-asynchronous-unwind-tables -fno-unwind-tables" \
	LDFLAGS="-Wl,--gc-sections -Wl,--no-eh-frame-hdr" \
	./Configure \
		--prefix="/" \
		--libdir="lib" \
		linux-$(strip $(arch)) \
		no-aria \
		no-bf \
		no-blake2 \
		no-camellia \
		no-cast \
		no-chacha \
		no-cmac \
		no-des \
		enable-dh \
		no-dsa \
		no-idea \
		no-md4 \
		no-mdc2 \
		no-ocb \
		no-poly1305 \
		no-rc2 \
		no-rc4 \
		no-rmd160 \
		no-seed \
		no-siphash \
		no-siv \
		no-sm2 \
		no-sm4 \
		no-tests \
		no-whirlpool \

# Heads ships libcrypto only; install libraries/headers without building apps.
openssl_target := $(MAKE_JOBS) install_dev DESTDIR="$(INSTALL)"

# Only libcrypto is needed currently, libssl is not included in initrd
openssl_libraries := \
	libcrypto.so.3 \

openssl_depends := $(musl_dep)
