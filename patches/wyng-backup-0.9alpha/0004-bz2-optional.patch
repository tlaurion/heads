# Needed: tool substitution.
# Make bz2 optional: the target CPython ships no _bz2/libbz2 (modules/cpython
# v1 has no bzip2), so the upstream top-level `import bz2` aborts every wyng
# invocation at startup.  Register the bz2 compressor only when the module
# imports, and report an unknown --compression value as OptionError.
diff --git a/src/wyng09a b/src/wyng09a
index 96a3802..c31d12d 100755
--- a/src/wyng09a
+++ b/src/wyng09a
@@ -23,10 +23,15 @@
 
 
 import sys, signal, os, pwd, grp, stat, shutil, subprocess as SPr, time, datetime
-import re, mmap, bz2, zlib, gzip, tarfile, io, fcntl, tempfile
+import re, mmap, zlib, gzip, tarfile, io, fcntl, tempfile
 import argparse, configparser, copy, hashlib, hmac, secrets, functools, uuid
 import getpass, base64, platform, resource, itertools, collections, string, struct
 import xml.etree.ElementTree, json, ctypes, ctypes.util, atexit
+
+try:
+    import bz2
+except:
+    bz2 = None
 from array import array   ; from urllib.parse import urlparse   ; from math import ceil
 from types import FunctionType
 
@@ -293,9 +298,9 @@ class ArchiveSet:
                 compression, compr_level = opts.compression.strip().split(":")
             else:
                 compression = opts.compression.strip()
-                compr_level = str(compressors[compression][1])
+                compr_level = str(compressors[compression][1]) if compression in compressors else ""
             compression = compression.strip()   ; compr_level = compr_level.strip()
-            if compression not in compressors or not is_num(compr_level):
+            if compression not in compressors.keys() or not is_num(compr_level):
                 raise OptionError("Invalid compression spec.")
 
             S.compression = compression      ; S.compr_level = compr_level
@@ -6334,8 +6339,8 @@ hash_bits        = 256    ; hash_bytes   = hash_bits // 8
 pjoin            = os.path.join     ; exists = os.path.exists   ; zipln = itertools.zip_longest
 
 # Dict of compressors in the form: (library, default_compress_level, compress_func)
-compressors =    {"zlib":   (zlib, 4, zlib.compress),
-                  "bz2" :   (bz2,  9, bz2.compress)}
+compressors =    {"zlib":   (zlib, 4, zlib.compress)}
+if bz2:    compressors["bz2"]  = (bz2,  9, bz2.compress)
 if zstd:   compressors["zstd"] = (zstd, 3, lambda data, lvl: zstd.compress(data, lvl, 3))
 
 hash_funcs  = {"hmac-sha256": None,
