# Needed: busybox/runtime guards.
# Avoid BusyBox df's rootfs/subdirectory failure and ps's GNU-only option form,
# use paths that exist in the Heads initrd, guard musl's unimplemented
# os.getgroups(), and turn unsupported reflink clones into a clean StorageError.
#
# Also pass init=True for arch-init and exit before reading the closed context's
# archive attribute. Without this, arch-init either skips archive creation or
# raises AttributeError after creating it. Enable dedup before destination
# detection for arch-deduplicate so hardlink support is probed before the action.
diff --git a/src/wyng09a b/src/wyng09a
--- a/src/wyng09a
+++ b/src/wyng09a
@@ -1866,9 +1866,14 @@
             ver = p[:5].decode("UTF-8").strip()    ; target_ver = "0.7.4"
             if p and ver < target_ver:
                 raise StorageError(7,"Thin provisioning tools version >= "+target_ver+" required.")
-        elif self.pooltype == "rlnk" and self.fstype == "btrfs":
-            # btrfs subvolume support is deferred in this build.
-            raise StorageError(7, "btrfs unsupported in this build")
+        elif self.pooltype == "rlnk":
+            if self.fstype == "btrfs":
+                # btrfs subvolume support is deferred in this build.
+                raise StorageError(7, "btrfs unsupported in this build")
+            # Non-btrfs reflink storage still needs extent scanning and clone
+            # support. Fail before creating snapshots if either is unavailable.
+            for prg in (CP.filefrag, CP.cp):
+                if not shutil.which(prg): raise StorageError(7, prg+" command not found.")
 
