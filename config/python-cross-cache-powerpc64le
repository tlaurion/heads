# Autoconf cache for the CPython target cross-build, powerpc64le-linux-musl.
#
# Pointed at via CONFIG_SITE by modules/cpython.  This is a starting set, not
# a verified one: the ppc64 target is validated only after x86_64 succeeds
# (manual milestone), and every entry below MUST be re-checked by an actual
# cross build.  powerpc64le is little-endian like x86_64, so the double
# endianness probe and the common ac_cv_* answers carry over; the explicit
# sizeof_* entries encode the LP64 ppc64le ABI so configure does not have to
# emulate target runs.  long_double is 16 bytes on ppc64le (musl/glibc).
ac_cv_buggy_getaddrinfo=no
ac_cv_file__dev_ptmx=yes
ac_cv_file__dev_ptc=no
ac_cv_func_dlopen=yes
ac_cv_little_endian_double=yes
ac_cv_broken_sem_getvalue=no
ac_cv_posix_semaphores_enabled=yes

ac_cv_sizeof_short=2
ac_cv_sizeof_int=4
ac_cv_sizeof_long=8
ac_cv_sizeof_long_long=8
ac_cv_sizeof_float=4
ac_cv_sizeof_double=8
ac_cv_sizeof_long_double=16
ac_cv_sizeof_void_p=8
ac_cv_sizeof_size_t=8
ac_cv_sizeof_off_t=8
ac_cv_sizeof_time_t=8
ac_cv_sizeof_pid_t=4
ac_cv_sizeof_wchar_t=4
ac_cv_sizeof_fpos_t=8

# _bz2/_lzma are deliberately not built: neither wyng nor the initrd needs
# them, and the dev-env's stale bzip2/xz pkg-config paths have no
# bzlib.h/lzma.h, so the module build would fail.  PY_STDLIB_MOD
# (configure.ac) only honours a skip via py_cv_module_<name>=n/a; "disabled"
# / "no" get overwritten by the have_bzip2/have_liblzma probe.
py_cv_module__bz2=n/a
py_cv_module__lzma=n/a
