CONFIG_DECOMPRESS_OFAST=y

#
# Boot Logo Configuration
#
# CONFIG_BMP_LOGO is not set
# CONFIG_PLATFORM_HAS_SECONDARY_BOOT_INDICATOR_LOGO is not set
