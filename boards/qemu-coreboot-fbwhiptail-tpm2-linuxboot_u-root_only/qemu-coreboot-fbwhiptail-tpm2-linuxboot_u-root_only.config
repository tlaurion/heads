# Configuration for building a coreboot ROM that only uses u-root
# (no Heads initramfs). u-root provides all userspace tools.
# Useful for testing TinyGo u-root builds in isolation.
export CONFIG_COREBOOT=y
export CONFIG_COREBOOT_VERSION=25.09
export CONFIG_LINUX_VERSION=6.1.8

CONFIG_COREBOOT_CONFIG=config/coreboot-qemu-tpm2.config
CONFIG_LINUX_CONFIG=config/linux-qemu.config

#On-demand hardware support (modules.cpio)
CONFIG_LINUX_USB=y
CONFIG_LINUX_E1000=y
export CONFIG_LINUX_USB_COMPANION_CONTROLLER=y

# Use u-root as the sole initramfs (no Heads init scripts)
CONFIG_UROOT=y

# Build u-root with TinyGo from tlaurion forks
UROOT_COMPILER ?= tinygo
UROOT_TAGS ?= tinygo.enable
UROOT_CMDS ?= core/* boot/* exp/* cluster/* contrib/* fwtools/*
# No Heads initramfs — u-root init (PID 1) runs directly
UROOT_DEFAULTSH=gosh
CONFIG_HEADS=n

# Minimal modules for QEMU testing
CONFIG_BUSYBOX=y
CONFIG_CRYPTSETUP2=y
CONFIG_FLASHPROG=y
CONFIG_FLASHTOOLS=y
CONFIG_GPG2=y
CONFIG_KEXEC=y
CONFIG_UTIL_LINUX=y
CONFIG_LVM2=y
CONFIG_MBEDTLS=y
CONFIG_PCIUTILS=y
CONFIG_MSRTOOLS=y
CONFIG_TPM2_TSS=y
CONFIG_OPENSSL=y
CONFIG_POPT=y
CONFIG_QRENCODE=y
CONFIG_TPMTOTP=y
CONFIG_CAIRO=y
CONFIG_FBWHIPTAIL=y
CONFIG_DROPBEAR=y

#Runtime configuration
export CONFIG_AUTO_BOOT_TIMEOUT=5
export CONFIG_TPM2_TOOLS=y
export CONFIG_PRIMARY_KEY_TYPE=ecc
export CONFIG_DEBUG_OUTPUT=y
export CONFIG_ENABLE_FUNCTION_TRACING_OUTPUT=y
export CONFIG_TPM2_CAPTURE_PCAP=y
export CONFIG_QUIET_MODE=n
export CONFIG_BOOT_REQ_HASH=n
export CONFIG_BOOT_REQ_ROLLBACK=n
export CONFIG_BOOT_RECOVERY_SERIAL="/dev/ttyS0"
export CONFIG_BOOT_KERNEL_ADD="console=ttyS0 console=tty systemd.zram=0 debug"
export CONFIG_BOOT_KERNEL_REMOVE="quiet rhgb splash"
export CONFIG_BOARD_NAME="qemu-coreboot-fbwhiptail-tpm2-linuxboot_u-root_only"
export CONFIG_KEYBOARD_KEYMAP="/usr/lib/kbd/keymaps/i386/qwerty/us.map"

BOARD_TARGETS := qemu
