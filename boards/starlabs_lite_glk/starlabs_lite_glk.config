# Architecture-evidence target only. Gemini Lake's signed IFWI and 0x1ffe00-byte
# COREBOOT region is 5,594,396 bytes short of full in-flash Heads. Reduced and
# staged profiles are unsupported; no internal flash command is set.
include $(pwd)/boards/starlabs/compact-analysis-intel.config
CONFIG_COREBOOT_CONFIG=config/coreboot-starlabs_lite_glk.config
export CONFIG_BOARD_NAME="Star Labs Lite Mk III (build analysis only)"
export CONFIG_COREBOOT_SMBIOS_PRODUCT_NAME=Lite
