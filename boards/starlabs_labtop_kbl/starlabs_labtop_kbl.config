# Architecture-evidence target only. The fixed 8 MiB layout is 2,744,604
# bytes short of the full in-flash Heads payload. Reduced and staged profiles
# are unsupported, and this target is not an active build or hardware gate.
include $(pwd)/boards/starlabs/compact-analysis-intel.config
CONFIG_COREBOOT_CONFIG=config/coreboot-starlabs_labtop_kbl.config
export CONFIG_BOARD_NAME="Star Labs LabTop Mk III"
export CONFIG_COREBOOT_SMBIOS_PRODUCT_NAME=LabTop
